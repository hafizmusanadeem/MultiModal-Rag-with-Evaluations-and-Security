# Groq Reasoning Engine (Llama 3.3)
GROQ_API_KEY = ""
GROQ_FALLBACK_API_KEY = ""

# Portkey LLM Gateway
PORTKEY_API_KEY = ""
PORTKEY_CONFIG_ID = ""          # was missing — gateway client requires it

# Qdrant Vector DB Settings
QDRANT_API_KEY = ""
QDRANT_CLUSTER_ENDPOINT = ""

# Gemini embeddings
GEMINI_API_KEY = ""

# === Observability

# Pydantic Logfire Observability
LOGFIRE_TOKEN = ""

# LANGSMITH
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""

# === Security / deployment
# Shared secret for the backend (clients send it as the X-API-Key header).
# Leave empty locally to disable auth. In production deploy.ps1 generates and stores it.
API_KEY = ""
# Set to 1 in production: never fall back to the local 768-dim embedder.
# REQUIRE_GEMINI = 1

# Streamlit UI -> FastAPI (local; on Streamlit Cloud set these in the app's Secrets instead)
BACKEND_URL = "http://localhost:8000"

# Eval judge
JUDGE_GROQ = "llama-3.3-70b-versatile"
